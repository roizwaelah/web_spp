APP_ENV=development
APP_NAME=web_spp_api

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=spp_madrasah_enterprise
DB_USER=root
DB_PASS=

# Wajib kuat (minimal 32 karakter) untuk production
JWT_SECRET=

# Pisahkan dengan koma bila lebih dari satu origin
CORS_ALLOWED_ORIGINS=https://spp.domainanda.net

# Supabase Storage (opsional, untuk upload otomatis kuitansi PDF)
SUPABASE_ENABLED=1
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=kuitansi
SUPABASE_BUCKET_RECEIPTS=kuitansi
SUPABASE_RECEIPT_UPLOAD_ENABLED=1
SUPABASE_RECEIPT_PATH_PREFIX=kuitansi
SUPABASE_RECEIPT_PUBLIC=0
SUPABASE_RECEIPT_SIGN_EXPIRES=604800
SUPABASE_RECEIPT_LINK_MODE=auto

# Fallback local link kuitansi (jika Supabase gagal/tidak aktif)
RECEIPT_PUBLIC_BASE_URL=https://spp.domainanda.net/api
RECEIPT_LINK_SECRET=
RECEIPT_LOCAL_PUBLIC_ENABLED=0
RECEIPT_LOCAL_PUBLIC_BASE_URL=https://spp.domainanda.net/spp/api/public/receipts

# URL portal pembayaran orang tua (dipakai di isi pesan WA pengingat tagihan)
PAYMENT_PORTAL_URL=https://spp.domainanda.net

# Kunci akses file test WA (wajib diisi agar script test tidak bisa diakses publik)
TEST_WA_SCRIPT_KEY=
# Kunci akses file test Supabase (opsional; jika kosong akan pakai TEST_WA_SCRIPT_KEY)
TEST_SUPABASE_SCRIPT_KEY=

# Kunci cron pengingat tagihan otomatis tanggal 5 & 15
BILL_REMINDER_CRON_KEY=
