APP_ENV=development
APP_NAME=web_spp_api

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=spp_madrasah_enterprise
DB_USER=root
DB_PASS=

# Wajib kuat (minimal 32 karakter) untuk production
JWT_SECRET=change-this-to-a-strong-random-secret-32-plus

# Pisahkan dengan koma, contoh:
# CORS_ALLOWED_ORIGINS=https://app.domainanda.com,https://admin.domainanda.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
